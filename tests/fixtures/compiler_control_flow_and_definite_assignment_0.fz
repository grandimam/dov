fn choose(n: int) -> str:
    if n < 0:
        return "negative"
    elif n == 0:
        word = "zero"
    else:
        word = "positive"
    return word

fn main():
    i = 0
    while i < 8:
        i = i + 1
        if i == 2:
            continue
        if i == 4:
            break
        print(i)
    print(choose(-1), choose(0), choose(1))
