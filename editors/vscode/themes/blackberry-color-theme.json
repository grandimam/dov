{
  "$schema": "vscode://schemas/color-theme",
  "name": "Faz Blackberry",
  "type": "dark",
  "semanticHighlighting": false,
  "colors": {
    "editor.background": "#211827",
    "editor.foreground": "#FFF4E5",
    "editorCursor.foreground": "#F28BA8",
    "editor.selectionBackground": "#634266",
    "editor.inactiveSelectionBackground": "#433047",
    "editor.selectionHighlightBackground": "#63426666",
    "editor.lineHighlightBackground": "#2B2032",
    "editorLineNumber.foreground": "#A18AA8",
    "editorLineNumber.activeForeground": "#FFF4E5",
    "editorWhitespace.foreground": "#594260",
    "editorIndentGuide.background1": "#3F3048",
    "editorIndentGuide.activeBackground1": "#A18AA8",
    "editorBracketMatch.background": "#634266",
    "editorBracketMatch.border": "#C9A7EB",
    "editorError.foreground": "#FF9CA5",
    "editorWarning.foreground": "#F2C779",
    "editorInfo.foreground": "#A4CBE8",
    "editorGutter.addedBackground": "#B6D7A8",
    "editorGutter.modifiedBackground": "#A4CBE8",
    "editorGutter.deletedBackground": "#F28BA8",
    "sideBar.background": "#1B1420",
    "sideBar.foreground": "#D9C9DC",
    "sideBarTitle.foreground": "#FFF4E5",
    "activityBar.background": "#17111B",
    "activityBar.foreground": "#F28BA8",
    "activityBar.inactiveForeground": "#A18AA8",
    "activityBarBadge.background": "#F28BA8",
    "activityBarBadge.foreground": "#211827",
    "titleBar.activeBackground": "#1B1420",
    "titleBar.activeForeground": "#FFF4E5",
    "titleBar.inactiveBackground": "#17111B",
    "statusBar.background": "#352039",
    "statusBar.foreground": "#FFF4E5",
    "statusBar.noFolderBackground": "#352039",
    "statusBar.debuggingBackground": "#634266",
    "tab.activeBackground": "#211827",
    "tab.activeForeground": "#FFF4E5",
    "tab.activeBorderTop": "#F28BA8",
    "tab.inactiveBackground": "#1B1420",
    "tab.inactiveForeground": "#B7A3BE",
    "editorGroupHeader.tabsBackground": "#17111B",
    "panel.background": "#1B1420",
    "panel.border": "#433047",
    "terminal.foreground": "#FFF4E5",
    "terminal.ansiRed": "#F28BA8",
    "terminal.ansiGreen": "#B6D7A8",
    "terminal.ansiYellow": "#F2C779",
    "terminal.ansiBlue": "#A4CBE8",
    "terminal.ansiMagenta": "#C9A7EB",
    "terminal.ansiCyan": "#A8D8CF",
    "focusBorder": "#C9A7EB",
    "button.background": "#F28BA8",
    "button.foreground": "#211827",
    "button.hoverBackground": "#F7A6BC",
    "input.background": "#2B2032",
    "input.foreground": "#FFF4E5",
    "input.border": "#634266",
    "dropdown.background": "#2B2032",
    "dropdown.foreground": "#FFF4E5",
    "list.activeSelectionBackground": "#634266",
    "list.activeSelectionForeground": "#FFF4E5",
    "list.hoverBackground": "#35283D",
    "textLink.foreground": "#F28BA8",
    "textLink.activeForeground": "#F7A6BC",
    "badge.background": "#634266",
    "badge.foreground": "#FFF4E5"
  },
  "tokenColors": [
    { "name": "Cream identifiers", "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#FFF4E5" } },
    { "name": "Muted mauve comments", "scope": "comment", "settings": { "foreground": "#B7A3BE", "fontStyle": "italic" } },
    { "name": "Raspberry keywords", "scope": ["keyword", "storage"], "settings": { "foreground": "#F28BA8" } },
    { "name": "Sage strings", "scope": "string", "settings": { "foreground": "#B6D7A8" } },
    { "name": "Honey constants", "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#F2C779" } },
    { "name": "Lavender functions", "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#C9A7EB" } },
    { "name": "Sky types", "scope": ["support.type", "entity.name.type", "storage.type"], "settings": { "foreground": "#A4CBE8" } },
    { "name": "Soft punctuation", "scope": "punctuation", "settings": { "foreground": "#D9C9DC" } },
    { "name": "Mint escapes", "scope": "constant.character.escape", "settings": { "foreground": "#A8D8CF" } },
    { "name": "Invalid syntax", "scope": "invalid", "settings": { "foreground": "#FF9CA5", "fontStyle": "underline" } }
  ]
}
