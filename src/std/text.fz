# Text helpers exposed through the str namespace.

fn rt_string_join(parts: int, separator: int, line: int) -> int:
    frame = rt_keep(parts, separator, 0)
    count = raw.load(parts)
    items = raw.load(parts + 16)
    separator_size = rt_size(separator)
    total = 0
    i = 0
    while i < count:
        total = total + rt_size(raw.load(items + i * 8))
        if i > 0:
            total = total + separator_size
        i = i + 1
    result = rt_heap(total + 1, 0, line)
    cursor = result
    i = 0
    while i < count:
        if i > 0:
            raw.copy(cursor, separator, separator_size)
            cursor = cursor + separator_size
        item = raw.load(items + i * 8)
        size = rt_size(item)
        raw.copy(cursor, item, size)
        cursor = cursor + size
        i = i + 1
    rt_release(frame)
    return result

fn rt_string_contains(text: int, needle: int) -> int:
    if raw.call("rt_os_strstr", text, needle) != 0:
        return 1
    return 0

