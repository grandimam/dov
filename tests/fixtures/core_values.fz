# Native value/ABI checks for the core language design.
struct Address:
    city: str
struct Person:
    name: str
    address: Address
    scores: list[int]
struct Pair:
    left: list[int]
    right: list[int]

fn increment(mut value: int):
    value += 1

fn replace(mut values: list[int]):
    values = [7, 8]

fn combine(mut left: list[int], mut right: list[int]):
    left.append(3)
    right.append(4)

fn next_index(mut calls: int) -> int:
    calls += 1
    return 0

fn main():
    mut count = 1
    increment(count)
    assert count == 2
    mut original = Person("Ali", Address("Dubai"), [80, 90])
    mut cloned = copy(original)
    assert original == cloned
    cloned.address.city = "Chennai"
    cloned.scores.append(100)
    assert original != cloned
    assert original.address.city == "Dubai"
    assert len(original.scores) == 2
    assert cloned.scores == [80, 90, 100]
    assert [1, 2] == [1, 2]
    assert [1, 2] != [1, 3]
    assert [1, 2] != [1]
    assert [[1], [2]] == [[1], [2]]
    mut nested = [[1], [2]]
    mut other = copy(nested)
    other[0].append(9)
    assert nested[0] == [1]
    mut pair = Pair([1], [2])
    combine(pair.left, pair.right)
    assert pair.left == [1, 3]
    assert pair.right == [2, 4]
    replace(pair.left)
    assert pair.left == [7, 8]
    mut numbers = [4, 5]
    increment(numbers[0])
    numbers[1] *= 2
    assert numbers == [5, 10]
    mut calls = 0
    numbers[next_index(calls)] += 1
    assert calls == 1
    assert numbers == [6, 10]
    print("core values passed")
