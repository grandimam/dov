import support

fn run(s: support.Suite):
    # test_diamond_import_records_enums_callbacks_and_scopes
    directory = support.fresh()
    fs.make_parent(directory + "/" + "shared.fz")
    fs.write_text(directory + "/" + "shared.fz", "enum Expr:\n    Number(value: int)\nstruct Node:\n    expression: Expr\nfn worker(n: int):\n    print(n)\nfn main():\n    panic(\"library main must not run\")\n")
    fs.make_parent(directory + "/" + "left.fz")
    fs.write_text(directory + "/" + "left.fz", "import shared\nfn make() -> shared.Node:\n    return shared.Node(shared.Expr.Number(42))\nfn total() -> int:\n    return 20\n")
    fs.make_parent(directory + "/" + "right.fz")
    fs.write_text(directory + "/" + "right.fz", "import shared\nfn show(node: shared.Node):\n    match node.expression:\n        case shared.Expr.Number(value):\n            print(value)\nfn total() -> int:\n    return 22\n")
    binary = support.source(s, directory, "import left\nimport right\nimport shared\nfn main():\n    node: shared.Node = left.make()\n    right.show(node)\n    with task.group() as group:\n        group.spawn(shared.worker, 7)\n    assert left.total() + right.total() == 42\n")
    support.success(s, support.capture(binary, []), "42\n7\n", "module behavior")
    fs.remove_temp(directory)
    # test_namespace_collisions_and_methods
    directory = support.fresh()
    fs.make_parent(directory + "/" + "a.fz")
    fs.write_text(directory + "/" + "a.fz", "fn b() -> int:\n    return 22\n")
    binary = support.source(s, directory, "import a\nfn a__b() -> int:\n    return 20\nfn main():\n    print(a.b() + a__b())\n")
    support.success(s, support.capture(binary, []), "42\n", "module behavior")
    fs.make_parent(directory + "/" + "helpers.fz")
    fs.write_text(directory + "/" + "helpers.fz", "fn append() -> int:\n    return 1\nfn pop() -> int:\n    return 2\nfn spawn() -> int:\n    return 3\n")
    binary = support.source(s, directory, "import helpers\nfn main():\n    print(helpers.append(), helpers.pop(), helpers.spawn())\n")
    support.success(s, support.capture(binary, []), "1 2 3\n", "module behavior")
    fs.remove_temp(directory)
    # test_overlapping_paths_have_distinct_namespaces
    directory = support.fresh()
    fs.make_parent(directory + "/" + "a.fz")
    fs.write_text(directory + "/" + "a.fz", "import b\nfn value() -> int:\n    return b.value()\n")
    fs.make_parent(directory + "/" + "b.fz")
    fs.write_text(directory + "/" + "b.fz", "fn value() -> int:\n    return 20\n")
    fs.make_parent(directory + "/" + "a/b.fz")
    fs.write_text(directory + "/" + "a/b.fz", "fn value() -> int:\n    return 22\n")
    binary = support.source(s, directory, "import a\nimport a.b\nfn main():\n    print(a.value(), b.value())\n")
    support.success(s, support.capture(binary, []), "20 22\n", "module behavior")
    fs.remove_temp(directory)
    # test_import_errors_identify_dependency
    directory = support.fresh()
    fs.make_parent(directory + "/" + "helper.fz")
    fs.write_text(directory + "/" + "helper.fz", "fn work():\n    print(missing)\n")
    fs.write_text(directory + "/main.fz", "import helper\nfn main():\n    helper.work()\n")
    result = support.capture_legacy(s.compiler, ["check", directory + "/main.fz"])
    support.check(s, result.status != 0 and support.contains(result.err, "helper.fz:2:11:") and support.contains(result.err, ""), "module rejection", result.err)
    fs.make_parent(directory + "/" + "helper.fz")
    fs.write_text(directory + "/" + "helper.fz", "import main\nfn work():\n    pass\n")
    fs.write_text(directory + "/main.fz", "import helper\nfn main():\n    helper.work()\n")
    result = support.capture_legacy(s.compiler, ["check", directory + "/main.fz"])
    support.check(s, result.status != 0 and support.contains(result.err, "cyclic import") and support.contains(result.err, ""), "module rejection", result.err)
    fs.make_parent(directory + "/" + "helper.fz")
    fs.write_text(directory + "/" + "helper.fz", "import absent\nfn work():\n    pass\n")
    fs.write_text(directory + "/main.fz", "import helper\nfn main():\n    helper.work()\n")
    result = support.capture_legacy(s.compiler, ["check", directory + "/main.fz"])
    support.check(s, result.status != 0 and support.contains(result.err, "absent.fz") and support.contains(result.err, ""), "module rejection", result.err)
    fs.remove_temp(directory)
    # test_imports_cannot_access_entry_declarations_or_shadow_modules
    directory = support.fresh()
    fs.make_parent(directory + "/" + "helper.fz")
    fs.write_text(directory + "/" + "helper.fz", "fn work():\n    print(secret())\n")
    fs.write_text(directory + "/main.fz", "import helper\nstruct Hidden:\n    value: int\nfn secret() -> int:\n    return 42\nfn main():\n    helper.work()\n")
    result = support.capture_legacy(s.compiler, ["check", directory + "/main.fz"])
    support.check(s, result.status != 0 and support.contains(result.err, "") and support.contains(result.err, "helper.fz:"), "module rejection", result.err)
    fs.make_parent(directory + "/" + "helper.fz")
    fs.write_text(directory + "/" + "helper.fz", "fn work():\n    value = Hidden(42)\n")
    fs.write_text(directory + "/main.fz", "import helper\nstruct Hidden:\n    value: int\nfn secret() -> int:\n    return 42\nfn main():\n    helper.work()\n")
    result = support.capture_legacy(s.compiler, ["check", directory + "/main.fz"])
    support.check(s, result.status != 0 and support.contains(result.err, "") and support.contains(result.err, "helper.fz:"), "module rejection", result.err)
    fs.make_parent(directory + "/" + "helper.fz")
    fs.write_text(directory + "/" + "helper.fz", "fn work(value: Hidden):\n    pass\n")
    fs.write_text(directory + "/main.fz", "import helper\nstruct Hidden:\n    value: int\nfn secret() -> int:\n    return 42\nfn main():\n    helper.work()\n")
    result = support.capture_legacy(s.compiler, ["check", directory + "/main.fz"])
    support.check(s, result.status != 0 and support.contains(result.err, "") and support.contains(result.err, "helper.fz:"), "module rejection", result.err)
    fs.make_parent(directory + "/" + "helper.fz")
    fs.write_text(directory + "/" + "helper.fz", "fn work():\n    pass\n")
    fs.write_text(directory + "/main.fz", "import helper\nimport helper\nfn main():\n    pass\n")
    result = support.capture_legacy(s.compiler, ["check", directory + "/main.fz"])
    support.check(s, result.status != 0 and support.contains(result.err, "") and support.contains(result.err, ""), "module rejection", result.err)
    fs.write_text(directory + "/main.fz", "import helper\nfn main():\n    helper.work()\n    helper = 1\n")
    result = support.capture_legacy(s.compiler, ["check", directory + "/main.fz"])
    support.check(s, result.status != 0 and support.contains(result.err, "") and support.contains(result.err, ""), "module rejection", result.err)
    fs.write_text(directory + "/main.fz", "import helper\nenum E:\n    V(x: int)\nfn main():\n    match E.V(1):\n        case E.V(helper):\n            print(helper)\n")
    result = support.capture_legacy(s.compiler, ["check", directory + "/main.fz"])
    support.check(s, result.status != 0 and support.contains(result.err, "") and support.contains(result.err, ""), "module rejection", result.err)
    fs.remove_temp(directory)
    # test_nested_pattern_names_restore_function_scope
    directory = support.fresh()
    fs.make_parent(directory + "/" + "lib.fz")
    fs.write_text(directory + "/" + "lib.fz", "enum E:\n    V(x: int)\nfn helper() -> int:\n    return 42\nfn inspect() -> int:\n    match E.V(7):\n        case E.V(helper):\n            print(helper)\n    return helper()\n")
    binary = support.source(s, directory, "import lib\nfn main():\n    print(lib.inspect())\n")
    support.success(s, support.capture(binary, []), "7\n42\n", "module behavior")
    fs.remove_temp(directory)
